# Used when running "npm run dev" / "npm run build" directly on your machine.
DATABASE_URL="postgresql://user:password@localhost:5432/elec_suivi?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# REQUIRED — the public URL users type in their browser to reach this app.
# Auth.js (next-auth v5) uses this value verbatim to build every absolute
# URL it generates (post-login redirect, post-logout redirect, the
# callback-url cookie) — it does NOT look at the incoming request's Host
# header, even with trustHost enabled. Get this wrong (or leave it at
# "http://localhost:3000" on a real server) and sign-in/sign-out will
# redirect every visitor's browser to THEIR OWN machine instead of back to
# this app — it looks exactly like "the button does nothing".
#   - Local dev on your machine:            http://localhost:3000
#   - VPS reachable by IP (no HTTPS):       http://<your-server-ip>:3000
#   - VPS with Caddy/HTTPS (see below):     https://<your SITE_ADDRESS>
#   - Behind a domain name (recommended):   https://your-domain.example
# docker-compose.yml refuses to start the "app" service without this set —
# that is deliberate, so a forgotten override fails loudly instead of
# silently sending users to localhost.
NEXTAUTH_URL="http://localhost:3000"

# --- docker compose ---
# Only these vars are read by docker-compose.yml (DATABASE_URL for the app
# container is built automatically from POSTGRES_PASSWORD and points at the
# "db" service, not at the value above). NEXTAUTH_URL above still applies
# to the "app" service and MUST be overridden here to your real public URL
# before deploying with docker-compose.yml on a server — the container
# won't start otherwise.
POSTGRES_PASSWORD="change-me"
SEED_ADMIN_EMAIL="admin@elec-suivi.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# REQUIRED for the "caddy" service — the public hostname Caddy requests a
# free, browser-trusted HTTPS certificate for (via Let's Encrypt). Let's
# Encrypt cannot issue a normal certificate for a bare IP address, so if you
# don't have a domain name, use a free auto-resolving hostname instead:
# replace the dots in your server's IP with dashes and append ".sslip.io"
# (e.g. 148.113.249.182 -> "148-113-249-182.sslip.io"); nip.io works the
# same way. If you do have a domain, point its DNS A record at this server
# and use that domain here instead. Ports 80 and 443 must be reachable from
# the internet (check your VPS/cloud firewall) for the certificate to be
# issued and renewed. Remember to also set NEXTAUTH_URL above to
# "https://" + this same hostname.
SITE_ADDRESS="148-113-249-182.sslip.io"
